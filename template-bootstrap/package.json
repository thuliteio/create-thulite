{
  "name": "bootstrap-starter",
  "version": "0.0.0",
  "description": "Thulite Bootstrap starter",
  "author": "Thulite",
  "license": "MIT",
  "scripts": {
    "create": "hugo new",
    "dev": "hugo server --disableFastRender --noHTTPCache",
    "portless": "portless run thulite-portless",
    "format": "prettier **/** -w -c",
    "build": "hugo --minify --gc",
    "preview": "vite preview --outDir public"
  },
  "dependencies": {
    "@thulite/bootstrap": "^1.2.3",
    "thulite": "^3.0.3"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "portless": "^0.15.6",
    "prettier": "^3.8.1",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
